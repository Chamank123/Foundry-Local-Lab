# Copy to .env and fill in what you have. chmod 600 .env
# Everything here is optional: JARVIS runs, indexes and answers without any of it.

# --- Voice (ElevenLabs, both directions). Without this, JARVIS is text-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5

# --- Model. Blank auto-discovers Foundry Local. Without one, routing falls
#     back to keyword scoring and the UI says so.
JARVIS_MODEL_URL=
JARVIS_MODEL=

# --- Your real folders. Only read when JARVIS_DEMO=0.
JARVIS_DEMO=1
JARVIS_ROOTS=

# --- Web research is off until you switch it on.
JARVIS_WEB=0
JARVIS_SEARCH_URL=

# --- Spend backstops for voice, per run.
JARVIS_TTS_BUDGET_CHARS=40000
JARVIS_STT_BUDGET_SECONDS=1800
